{
    "name": "wexts",
    "version": "4.1.0",
    "description": "Production-focused single-runtime Next.js + NestJS toolkit with typed RPC.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "bin": {
        "wexts": "bin/wexts.cjs"
    },
    "files": [
        "dist",
        "templates",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.mjs",
            "require": "./dist/client/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.mjs",
            "require": "./dist/types/index.js"
        },
        "./nest": {
            "types": "./dist/nest/index.d.ts",
            "import": "./dist/nest/index.mjs",
            "require": "./dist/nest/index.js"
        },
        "./next": {
            "types": "./dist/next/index.d.ts",
            "import": "./dist/next/index.mjs",
            "require": "./dist/next/index.js"
        },
        "./rpc": {
            "types": "./dist/rpc/index.d.ts",
            "import": "./dist/rpc/index.mjs",
            "require": "./dist/rpc/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.mjs",
            "require": "./dist/runtime/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.mjs",
            "require": "./dist/server/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "release": "npm run build && npm publish --access public"
    },
    "keywords": [
        "wexts",
        "framework",
        "fullstack",
        "nestjs",
        "nextjs",
        "monorepo",
        "typescript",
        "react",
        "unified-runtime",
        "generated-rpc",
        "type-safe",
        "prisma",
        "jwt-auth",
        "docker",
        "next.js",
        "nest.js"
    ],
    "author": "WEXTS Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ziadmustafa1/wexts.git"
    },
    "homepage": "https://github.com/ziadmustafa1/wexts#readme",
    "bugs": {
        "url": "https://github.com/ziadmustafa1/wexts/issues"
    },
    "engines": {
        "node": ">=20.9.0",
        "pnpm": ">=10.0.0"
    },
    "devDependencies": {
        "@swc/core": "^1.15.32",
        "@types/http-proxy": "^1.17.15",
        "@types/node": "^22.19.1",
        "@types/react": "^19.2.14",
        "eslint": "^9.17.0",
        "tsup": "^8.5.1",
        "vite": "^6.4.2",
        "vitest": "^4.1.5"
    },
    "dependencies": {
        "@wexts/security": "^0.1.0",
        "chokidar": "^4.0.3",
        "commander": "^14.0.3",
        "consola": "^3.2.3",
        "fastify": "^5.8.5",
        "http-proxy": "^1.18.1",
        "picocolors": "^1.1.1",
        "reflect-metadata": "^0.2.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.0",
        "next": "^16.2.4",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "peerDependenciesMeta": {
        "@nestjs/common": {
            "optional": true
        },
        "@nestjs/core": {
            "optional": true
        },
        "@nestjs/platform-fastify": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "next": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
