{
  "name": "@wexts/security",
  "version": "0.1.0",
  "description": "Wexts Shield security plugin for Fastify runtimes.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.19.1",
    "fastify": "^5.8.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
